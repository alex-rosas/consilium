# Docker Compose environment overrides
# Copy values you need to a .env file, or export them before running docker-compose.
#
# Usage:
#   cp .env.docker.example .env   # then edit .env
#   docker-compose up
#
# Or inline:
#   OLLAMA_BASE_URL=http://172.17.0.1:11434 docker-compose up

# ---- LLM Configuration ----

# Default: http://host.docker.internal:11434
# Linux: replace with your docker0 bridge IP (find with: ip addr show docker0)
# OLLAMA_BASE_URL=http://172.17.0.1:11434

# Default: llama3.1:8b
# OLLAMA_MODEL=llama3.1:8b

# ---- Retrieval Configuration ----

# Default: mock (no external dependency)
# Set to "quaestor" when Quaestor service is running
# RETRIEVAL_PROVIDER=mock

# Default: http://host.docker.internal:8000
# Linux: replace with your docker0 bridge IP
# QUAESTOR_BASE_URL=http://172.17.0.1:8000

# Allow fallback to MockRetrieval if Quaestor is unreachable (dev only)
# ALLOW_MOCK_FALLBACK=false

# ---- Logging ----

# Default: INFO  (options: DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

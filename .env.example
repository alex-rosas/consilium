# ============================================================
# Consilium — Environment Variables
# Copy to .env and adjust for your setup.
# ============================================================

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# Retrieval Provider (Phase 2+)
# "mock"     → deterministic MockRetrieval (default, no external dependency)
# "quaestor" → real HTTP calls to Quaestor service
RETRIEVAL_PROVIDER=mock

# Quaestor Integration (used when RETRIEVAL_PROVIDER=quaestor)
# Quaestor runs as an independent service at port 8000 (separate repo)
QUAESTOR_BASE_URL=http://localhost:8000

# When true: QuaestorClient connection errors fall back to MockRetrieval
# Never set true in production — silently serves stale data
ALLOW_MOCK_FALLBACK=false

# Logging
LOG_LEVEL=INFO

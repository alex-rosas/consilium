# ============================================================
# Consilium — Environment Variables
# Copy to .env and fill in your values.
# ============================================================

# ── LLM ─────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# ── Retrieval ────────────────────────────────────────────────
# "mock"     → deterministic MockRetrieval, no external dependency
# "quaestor" → real HTTP calls to the Quaestor service (separate repo)
#              Requires Quaestor running at QUAESTOR_BASE_URL.
RETRIEVAL_PROVIDER=quaestor
QUAESTOR_BASE_URL=http://localhost:8000

# ── Observability ────────────────────────────────────────────
# OTLP HTTP endpoint for Arize Phoenix.
# Docker Compose sets this automatically; only needed for local dev.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OTel trace sampling rate (0.0–1.0). 1.0 = sample all (dev default).
TRACE_SAMPLE_RATE=1.0

# ── Workflow ─────────────────────────────────────────────────
# Confidence threshold for agent fallback (0.0–1.0).
# Eval data shows bimodal distribution: 0.30 (fallback) / 0.85 (success).
# 0.5 correctly separates the two populations.
CONFIDENCE_THRESHOLD=0.5

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
